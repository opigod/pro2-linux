diff --git a/src/hidpp20.c b/src/hidpp20.c
index 7064507..d1b5acb 100644
--- a/src/hidpp20.c
+++ b/src/hidpp20.c
@@ -1264,6 +1264,57 @@ hidpp20_rgb_effects_get_effect_info(struct hidpp20_device *device,
 	return 0;
 }
 
+int
+hidpp20_rgb_effects_set_sw_control(struct hidpp20_device *device,
+				   uint8_t control,
+				   uint8_t events)
+{
+	union hidpp20_message msg = {
+		.msg.report_id = REPORT_ID_SHORT,
+		.msg.device_idx = device->index,
+		.msg.address = CMD_RGB_EFFECTS_MANAGE_SW_CONTROL,
+		.msg.parameters[0] = 0x01,
+		.msg.parameters[1] = control,
+		.msg.parameters[2] = events,
+	};
+	uint8_t feature_index;
+
+	feature_index = hidpp_root_get_feature_idx(device, HIDPP_PAGE_RGB_EFFECTS);
+	if (feature_index == 0)
+		return -ENOTSUP;
+
+	msg.msg.sub_id = feature_index;
+	return hidpp20_request_command(device, &msg);
+}
+
+int
+hidpp20_rgb_effects_set_cluster_effect(struct hidpp20_device *device,
+				       uint8_t cluster_index,
+				       uint8_t effect_index,
+				       const uint8_t params[10],
+				       uint8_t persistence,
+				       uint8_t power_mode)
+{
+	union hidpp20_message msg = {
+		.msg.report_id = REPORT_ID_LONG,
+		.msg.device_idx = device->index,
+		.msg.address = CMD_RGB_EFFECTS_SET_RGB_CLUSTER_EFFECT,
+		.msg.parameters[0] = cluster_index,
+		.msg.parameters[1] = effect_index,
+	};
+	uint8_t feature_index;
+
+	memcpy(&msg.msg.parameters[2], params, 10);
+	msg.msg.parameters[12] = (persistence & 0x03) | ((power_mode & 0x03) << 2);
+
+	feature_index = hidpp_root_get_feature_idx(device, HIDPP_PAGE_RGB_EFFECTS);
+	if (feature_index == 0)
+		return -ENOTSUP;
+
+	msg.msg.sub_id = feature_index;
+	return hidpp20_request_command(device, &msg);
+}
+
 /* -------------------------------------------------------------------------- */
 /* 0x1b04: Special keys and mouse buttons                                     */
 /* -------------------------------------------------------------------------- */
